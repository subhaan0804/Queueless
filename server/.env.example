# MongoDB connection string. Required.
MONGO_URI=mongodb://127.0.0.1:27017/queueless

# Optional when the database name is already included in MONGO_URI.
MONGO_DB_NAME=queueless

# Optional: defaults to 4000.
PORT=4000

# Expo Push Service endpoint. Required for background turn notifications.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
