# Copy this file to `.env` and edit it. `.env` is git-ignored: never commit real credentials.

# Port the API listens on. If you change it, also set EXPO_PUBLIC_API_URL in app/.env.
PORT=4000

# Option A: MongoDB on this computer (install MongoDB Community and start it).
MONGO_URI=mongodb://127.0.0.1:27017/queueless

# Option B: MongoDB Atlas (free M0 cluster). Replace the line above with your connection string.
# Keep the database name "queueless" before the "?", and use a password without special characters.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/queueless?retryWrites=true&w=majority
